# Rémunération de l'interface quand l'app est mise en ligne (voir src/partner.ts et le README, « Mise en ligne »).
# Copier ce fichier en .env et remplir ; sans ces valeurs, aucun frais n'est demandé ni ajouté aux ordres.

# Adresse qui reçoit le frais d'interface (builder code Hyperliquid).
VITE_HL_BUILDER=
# Frais en dixièmes de point de base : 10 = 0,01 %, 50 = 0,05 %, 100 = 0,1 % (maximum d'Hyperliquid sur les perpétuels).
VITE_HL_BUILDER_FEE=10
# « false » pour laisser trader sans avoir autorisé le frais (obligatoire sinon).
VITE_HL_BUILDER_REQUIRED=true
# Code de parrainage proposé aux comptes qui n'ont pas encore de parrain.
VITE_HL_REFERRAL_CODE=

# Adresse du relais des statistiques OKX, si l'hébergeur ne sert pas /proxy/okx (voir README, « Mise en ligne : hébergement »).
# VITE_OKX_RELAY=https://mon-relais.exemple/proxy/okx

# Adresse du serveur de données (collecteur, voir README, « Serveur de données multi-actifs »). Absente : l'historique est lu
# directement chez les exchanges. Les valeurs réelles sont dans .env.production (en ligne) et .env.collector (local).
# VITE_DATA_API=https://data.exemple
